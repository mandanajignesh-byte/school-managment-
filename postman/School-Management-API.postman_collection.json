{
  "info": {
    "name": "School Management API",
    "description": "Postman collection for adding schools and listing schools by proximity.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Add School",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Delhi Public School\",\n  \"address\": \"Mathura Road, New Delhi\",\n  \"latitude\": 28.5821,\n  \"longitude\": 77.2461\n}"
        },
        "url": "{{baseUrl}}/addSchool",
        "description": "Expected response: 201 Created with the inserted school's id and submitted details."
      }
    },
    {
      "name": "List Schools by Proximity",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/listSchools?latitude=28.6139&longitude=77.2090",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "listSchools"
          ],
          "query": [
            {
              "key": "latitude",
              "value": "28.6139"
            },
            {
              "key": "longitude",
              "value": "77.2090"
            }
          ]
        },
        "description": "Expected response: 200 OK with schools sorted nearest-first and distance_km included for each item."
      }
    }
  ]
}
